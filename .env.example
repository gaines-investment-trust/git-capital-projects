# Local development settings. Copy to .env.local. Never commit real secrets.
DATABASE_URL=postgres://gcp:gcp@localhost:5432/gcp
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_TRUST_HOST=true
# Local only: sign in without Microsoft as a seeded user
AUTH_DEV_LOGIN=1
BOOTSTRAP_ADMIN_EMAIL=joeg@gainesinvestmenttrust.com

# Microsoft sign-in (optional locally)
AUTH_MICROSOFT_ENTRA_ID_ID=0fc09c94-b943-468b-8642-4616315e435c
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=6cbf8d55-4474-4ef5-85d7-d5144d970539
AUTH_MICROSOFT_ENTRA_ID_SECRET=

# Documents: "local" writes to a folder on disk; "graph" writes to SharePoint
DOCSTORE=local
LOCAL_DOCSTORE_DIR=.data/sharepoint
